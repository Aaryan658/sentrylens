{
  "name": "@sentrylens/extension",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "vendor": "node scripts/vendor-runtimes.mjs",
    "build": "node scripts/vendor-runtimes.mjs && wxt build",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "e2e": "node e2e/run.mjs",
    "eval": "node eval/run.mjs",
    "live": "node --import tsx eval/live-page.ts --dpr=1,1.25,1.5,2 --check"
  },
  "dependencies": {
    "@sentrylens/shared": "workspace:*",
    "@huggingface/transformers": "3.7.1",
    "onnxruntime-web": "1.20.1",
    "tesseract.js": "5.1.1",
    "@mediapipe/tasks-vision": "0.10.20",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "wxt": "0.19.13",
    "@wxt-dev/module-react": "1.1.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/chrome": "0.0.287",
    "tsx": "4.19.2",
    "sharp": "0.34.5"
  }
}
