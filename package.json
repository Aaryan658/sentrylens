{
  "name": "sentrylens",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:ext": "pnpm --filter @sentrylens/extension dev",
    "build:ext": "pnpm --filter @sentrylens/extension build",
    "dev:server": "pnpm --filter @sentrylens/server dev",
    "typecheck": "tsc -b --pretty"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "@types/node": "22.10.2"
  },
  "packageManager": "pnpm@11.5.1"
}
